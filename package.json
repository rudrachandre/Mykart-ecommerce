{
  "name": "mykart-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prisma": "^7.9.1",
    "turbo": "^1.12.5",
    "typescript": "^5.4.2"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "bcrypt@6.0.0": true
  },
  "overrides": {
    "zod": "4.5.0-canary.20260814T233931"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
