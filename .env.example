# Application
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://mykart:mykartpassword@localhost:5432/mykart?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""
MEILI_MASTER_KEY=""

# Authentication — REQUIRED. At least 32 characters; the API fails to start without it.
AUTH_SECRET=

# Cloudinary (Image Assets)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Razorpay (Payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cookie / session hardening (optional)
# COOKIE_DOMAIN: set to ".yourdomain.com" to share auth cookies across subdomains
COOKIE_DOMAIN=
# COOKIE_SAME_SITE: "lax" | "strict" | "none" (default "lax")
COOKIE_SAME_SITE="lax"

# Inventory reservation window in milliseconds (optional, default 900000)
INVENTORY_RESERVATION_TTL_MS=900000
