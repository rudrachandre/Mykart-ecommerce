# ==========================================
# MyKart — Environment Configuration Template
# ==========================================

# Application Settings
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Database Configuration (Neon PostgreSQL) — REQUIRED
DATABASE_URL="postgresql://mykart:mykartpassword@localhost:5432/mykart?schema=public"

# Redis Cache & Locking — OPTIONAL (Falls back gracefully if inactive)
REDIS_URL="redis://localhost:6379"

# Meilisearch Engine — OPTIONAL (Falls back to PostgreSQL ILIKE search)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""
MEILI_MASTER_KEY=""

# Authentication Secrets — REQUIRED (API will fail startup if missing)
# Must be a secure string of at least 32 characters
AUTH_SECRET="your_secure_random_jwt_secret_min_32_chars"

# Cookie / Session Security — OPTIONAL
# Set COOKIE_DOMAIN to ".yourdomain.com" in production to share auth cookies across subdomains
COOKIE_DOMAIN=""
COOKIE_SAME_SITE="lax"

# Inventory Reservation TTL — OPTIONAL (Default: 900000 ms / 15 mins)
INVENTORY_RESERVATION_TTL_MS=900000

# Cloudinary Asset Storage — OPTIONAL (Required for uploading new seller images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend Transactional Email — OPTIONAL (Required for email notifications)
RESEND_API_KEY=""
